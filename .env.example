# Copy to .env, fill values on the server only, chmod 600 .env. NEVER commit .env.
# ---- mode: paper (default) | simulate | live
MODE=paper
DATA_DIR=./data
# ---- Helius (recommended). Add HELIUS_API_KEY as a GitHub Actions secret.
# Never commit the actual key. Helius mainnet endpoints:
# wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=
# ---- data feed (comma-separated websocket URLs; 2+ providers recommended). Keys go inside the URL.
FEED_WS_URLS=
# ---- HTTP RPC for account reads / simulate / send
RPC_HTTP_URL=
# optional extra send endpoints (e.g. a Helius sender / staked endpoint), comma-separated
SEND_RPC_URLS=
# optional Jito block engine sendTransaction endpoint + tip
JITO_URL=
JITO_TIP_LAMPORTS=0
PRIORITY_MICRO_LAMPORTS=200000
CU_LIMIT=120000
# ---- strategy
LANES=K,B
K_BUY_SELL_RATIO=1.0
K_MIN_TRADES_10=4
K_MIN_BUY_USD_10=25
TRADEABLE_QUOTES=SOL
TP_MULT=1.5
MAX_HOLD_S=90
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=3000,6000,9500
# ---- bankroll
START_WALLET_USD=2
BASE_STAKE_USD=1
MAX_STAKE_USD=20
MAX_TRADES_PER_DAY=50
DAILY_LOSS_CAP=0.25
KILL_WALLET_USD=1.20
LIVE_REQUIRE_PAPER_EDGE=yes
# ---- simulate mode: a PUBLIC key only (your burner wallet's address)
SIM_WALLET_PUBKEY=
# ---- live mode only (burner wallet holding only what you can lose)
I_UNDERSTAND_RISK=
WALLET_PRIVATE_KEY=
# ---- optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
